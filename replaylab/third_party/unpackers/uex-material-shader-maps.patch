diff --git a/tests/Uex.Tests/MaterialShaderMapEvidenceTests.cs b/tests/Uex.Tests/MaterialShaderMapEvidenceTests.cs
new file mode 100644
index 0000000..0d1f7d7
--- /dev/null
+++ b/tests/Uex.Tests/MaterialShaderMapEvidenceTests.cs
@@ -0,0 +1,175 @@
+using System.Runtime.CompilerServices;
+using System.Text;
+using CUE4Parse.UE4.Assets.Exports.Material;
+using CUE4Parse.UE4.Versions;
+using Newtonsoft.Json.Linq;
+using Serilog;
+using Uex.Config;
+using Uex.Core;
+using Xunit;
+
+namespace Uex.Tests;
+
+public sealed class MaterialShaderMapEvidenceTests
+{
+    [Theory]
+    [InlineData("../escape.uasset")]
+    [InlineData("A/../escape.uasset")]
+    [InlineData("A/*.uasset")]
+    [InlineData("C:/outside.uasset")]
+    [InlineData("/outside.uasset")]
+    [InlineData("A/Texture.ubulk")]
+    public void RejectsTraversalWildcardsAndNonPackages(string asset)
+    {
+        Assert.ThrowsAny<Exception>(() => MaterialShaderMapEvidence.ValidateAssetPath(Path.GetTempPath(), asset));
+    }
+
+    [Fact]
+    public void ExactPathAcceptsEitherSeparatorAndOptionalExtension()
+    {
+        Assert.Equal("Game/Content/M_Material.uasset", MaterialShaderMapEvidence.ValidateAssetPath(Path.GetTempPath(), "Game\\Content\\M_Material"));
+    }
+
+    [Fact]
+    public void DeclaredVersionCandidatesAreNotSilentlyChosen()
+    {
+        var result = MaterialShaderMapEvidence.Read(new GameProfile { Versions = ["GAME_SilverPalace"], PaksDir = Path.GetTempPath() }, "Game/M.uasset");
+        var json = JObject.Parse(result.Json);
+        Assert.Equal(1, result.ExitCode);
+        Assert.Equal("unsupported", json["status"]);
+        Assert.False(json["readShaderMaps"]!["attempted"]!.Value<bool>());
+        Assert.False(json["readShaderMaps"]!["completed"]!.Value<bool>());
+    }
+
+    [Fact]
+    public void MissingExactFileDoesNotSearchOrMountAnyTree()
+    {
+        var result = MaterialShaderMapEvidence.Read(new GameProfile { Game = "GAME_SilverPalace", PaksDir = Path.GetTempPath() }, "Missing-Evidence-Test/M.uasset");
+        var json = JObject.Parse(result.Json);
+        Assert.Equal(1, result.ExitCode);
+        Assert.Equal("unsupported", json["status"]);
+        Assert.Empty((JArray)json["asset"]!["inputs"]!);
+        Assert.False(json["readShaderMaps"]!["attempted"]!.Value<bool>());
+    }
+
+    [Fact]
+    public void InvalidPackageProducesStructuredFailureAndRestoresLogger()
+    {
+        var directory = Path.Combine(Path.GetTempPath(), "uex-inline-test-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(directory);
+        try
+        {
+            File.WriteAllBytes(Path.Combine(directory, "Bad.uasset"), new byte[128]);
+            var logger = Log.Logger;
+            var result = MaterialShaderMapEvidence.Read(new GameProfile { Game = "GAME_SilverPalace", PaksDir = directory }, "Bad.uasset");
+            var json = JObject.Parse(result.Json);
+            Assert.Equal(1, result.ExitCode);
+            Assert.True(json["readShaderMaps"]!["attempted"]!.Value<bool>());
+            Assert.False(json["readShaderMaps"]!["completed"]!.Value<bool>());
+            Assert.NotEmpty((JArray)json["diagnostics"]!);
+            Assert.Equal(64, json["asset"]!["inputs"]![0]!["sha256"]!.Value<string>()!.Length);
+            Assert.Same(logger, Log.Logger);
+        }
+        finally { Directory.Delete(directory, recursive: true); }
+    }
