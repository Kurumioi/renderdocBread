# Vendored build/runtime inputs are not locally generated binaries. Keep these
# SDKs and project utilities visible while excluding outputs elsewhere.
!/qrenderdoc/3rdparty/python/**/*.dll
!/qrenderdoc/3rdparty/python/**/*.lib
!/qrenderdoc/3rdparty/python/**/*.pyd
!/qrenderdoc/3rdparty/python/python36.zip
!/qrenderdoc/3rdparty/qt/**/*.dll
!/qrenderdoc/3rdparty/qt/**/*.lib
!/qrenderdoc/3rdparty/qt/**/*.exe
!/qrenderdoc/3rdparty/pyside/**/*.dll
!/qrenderdoc/3rdparty/pyside/**/*.lib
!/qrenderdoc/3rdparty/pyside/**/*.pyd
!/qrenderdoc/3rdparty/swig/swig.exe
!/renderdoc/3rdparty/breakpad/dump_syms.exe
!/renderdoc/3rdparty/dbghelp/**/*.dll
!/renderdoc/3rdparty/dbghelp/**/symsrv.yes
!/renderdoc/3rdparty/Detours/lib.X*/detours.lib
# Vendor debug symbols are supplied with these prebuilt library inputs.
!/renderdoc/3rdparty/Detours/lib.X*/detours.pdb
!/util/clangformat/clang-format-15.0.exe

