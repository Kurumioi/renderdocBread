# Local build/dependency inspection outputs. Keep these root-anchored so similarly named source
# directories elsewhere in the tree remain visible to Git.
/x64/
/qrenderdoc_3rdparty.download.zip
/qrenderdoc_3rdparty_inspect_*/
/build-*/
/compile_commands.json
.cache/
.pytest_cache/
# Pytest scratch belongs in the operating-system temp directory. These exact
# patterns only protect aborted/legacy runs; test configuration redirects new
# repository-local --basetemp requests before tmp_path is created.
**/.pytest-*/
**/.tmp-pytest-*/
**/.test-tmp-*/
**/_pytest_*/
**/.tmp-test-*/
/dist/
/package/
# This directory may contain signing credentials and machine-specific helpers.
# Its checked-in README remains project documentation.
/util/buildscripts/support/*
!/util/buildscripts/support/README.md
/qrenderdoc/Makefile
/qrenderdoc/Makefile.Debug
/qrenderdoc/Makefile.Release
*.exe
*.aps
*.ilk
*.intermediate.manifest
*.embed.manifest
*.user
